<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f8f4" />
    <title>@ViewData["Title"] - study_room_booking</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/study_room_booking.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header>
        <div class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="To front page">Study Room Booking</a>
        <nav aria-label="Main menu" class="main-nav">
            <a asp-controller="Home" asp-action="Index" asp-fragment="sessions">Find a study session</a>
            <a asp-controller="Room" asp-action="Table">Rooms</a>
        </nav>
       @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="account-actions">
                <span class="profile-link">
                    <span class="avatar" aria-hidden="true">@(User.Identity.Name?.Substring(0, 1).ToUpperInvariant() ?? "R")</span>
                    <span>@User.Identity.Name</span>
                </span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="logout-button" type="submit">Logg ut</button>
                    </form>
            </div>
        }
        else
        {
            <a class="profile-link login-nav-link" asp-controller="Account" asp-action="Login"><span class="avatar" aria-hidden="true">↗</span><span>Logg inn</span></a>
        }
        </div>
    </header>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
