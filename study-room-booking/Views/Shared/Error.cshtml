@* General error page shown to users in production when an unexpected error occurs.
    Technical details are logged on the server and never shown to the user. *@    

@{  
    // Sets the page title shown in the browser tab (used by <title> in_Layout.cshtml)
    ViewData["Title"] = "Error";
}

<section class="text-center py-5">
    <h1>Something went wrong!</h1>
    <p>We could not complete your request. Please try again later. </p> 
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to the front page</a>
</section>