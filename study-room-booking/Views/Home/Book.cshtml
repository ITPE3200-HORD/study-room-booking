@model BookViewModel

@{
    ViewData["Title"] = "Book a room";
    var requestedDate = Model.Date.ToString("yyyy-MM-dd");
    var requestedStartTime = Model.StartTime.ToString("HH:mm");
}

<section class="booking-page" aria-labelledby="booking-title">
    <a class="back-link" asp-controller="Home" asp-action="Index">
        <span aria-hidden="true">←</span> 
        Back to main page
    </a>

    <header class="booking-heading">
        <div>
            <div class="eyebrow muted">ROOM BOOKING</div>
            <h1 id="booking-title">Find an available room</h1>
            <p>Choose a date, time and group size to see suitable rooms.</p>
        </div>
        <p class="booking-campus">OsloMet - Pilestredet</p>
    </header>

    <div class="booking-layout">
        <div class="room-finder">
            <section class="room-search-panel" aria-labelledby="search-rooms-title">
                <h2 id="search-rooms-title">Search for a room</h2>

                <form asp-controller="Home" asp-action="Book" method="get" class="row g-3 align-items-end">
                    <div asp-validation-summary="ModelOnly" class="col-12 text-danger" role="alert"></div>
                    
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label asp-for="Date" class="form-label">Date</label>
                        <input asp-for="Date" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label asp-for="StartTime" class="form-label">Start time</label>
                        <select asp-for="StartTime" class="form-select">
                            <option value="06:00">06:00</option>
                            <option value="07:00">07:00</option>
                            <option value="08:00">08:00</option>
                            <option value="09:00">09:00</option>
                            <option value="10:00">10:00</option>
                            <option value="11:00">11:00</option>
                            <option value="12:00">12:00</option>
                            <option value="13:00">13:00</option>
                            <option value="14:00">14:00</option>
                            <option value="15:00">15:00</option>
                            <option value="16:00">16:00</option>
                            <option value="17:00">17:00</option>
                            <option value="18:00">18:00</option>
                            <option value="19:00">19:00</option>
                            <option value="20:00">20:00</option>
                            <option value="21:00">21:00</option>
                            <option value="22:00">22:00</option>
                        </select>
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label asp-for="DurationMinutes" class="form-label">Duration</label>
                        <select asp-for="DurationMinutes" class=form-select>
                            <option value="60">1 hour</option>
                            <option value="90">1.5 hours</option>
                            <option value="120">2 hours</option>
                            <option value="180">3 hours</option>
                        </select>
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label asp-for="GroupSize" class="form-label">Group size</label>
                        <select asp-for="GroupSize" class="form-select">
                            <option value="2">2 people</option>
                            <option value="4">4 people</option>
                            <option value="6">6 people</option>
                            <option value="8">8 people</option>
                        </select>
                        <span asp-validation-for="GroupSize" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label asp-for="RoomType" class="form-label">Room type</label>
                        <select asp-for="RoomType" class="form-select">
                            <option value="">All room types</option>
                            <option value="Group Study Room">Group Study Room</option>
                            <option value="Class Room">Class Room</option>
                            <option value="Auditorium">Auditorium</option>
                        </select>
                        <span asp-validation-for="RoomType" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            Search available rooms
                        </button>
                    </div>
                </form>         
            </section>

            @if (ViewData.ModelState.IsValid)
            {
                <section class="room-results" aria-labelledby="available-rooms-title">
                    <div class="room-results-heading">
                        <div>
                            <h2 id="available-rooms-title">Available rooms</h2>
                            <p aria-live="polite">
                                @Model.AvailableRoomCount
                                @(Model.AvailableRoomCount == 1 ? "room" : "rooms")
                                available for your search.
                            </p>
                        </div>
                    </div>

                    @if (Model.AvailableRoomCount == 0)
                    {
                        <div class="alert alert-info" role="status">
                            <h3 class="h5">No rooms found</h3>
                            <p class="mb-0">
                                Try another date, time or group size or room type to find available rooms. You can also check the room directory to see all rooms and their details.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var room in Model.AvailableRooms)
                            {
                                <div class="col-12 col-md-6">
                                    <article class="card h-100 shadow-sm">
                                        <div class="card-body">
                                            <p class="text-success fw-semibold mb-2">Available</p>
                                            <h3 class="card-title h5">Room @room.RoomNumber</h3>

                                            @if (!string.IsNullOrWhiteSpace(room.Location))
                                            {
                                                <p class="card-text">
                                                    <span class="fw-semibold">Location:</span>
                                                    @room.Location
                                                </p>
                                            }

                                            <p class="card-text">
                                                <span class="fw-semibold">Room type:</span>
                                                @room.RoomType
                                            </p>
                                            <p class="card-text">
                                                <span class="fw-semibold">Capacity:</span>
                                                @room.Capacity people
                                            </p>

                                            <a asp-controller="Booking" 
                                                asp-action="Create" 
                                                asp-route-roomId="@room.RoomId" 
                                                asp-route-date="@requestedDate" 
                                                asp-route-startTime="@requestedStartTime" 
                                                asp-route-durationMinutes="@Model.DurationMinutes" 
                                                class="btn btn-primary">
                                                Continue to booking
                                                <span class="visually-hidden">
                                                    for room @room.RoomNumber
                                                </span>
                                            </a>
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}