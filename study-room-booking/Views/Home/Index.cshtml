@model HomeIndexViewModel

@{
    ViewData["Title"] = "Find a study room";
}

<section class="hero" aria-labelledby="home-title">
    <div class="home-intro-content">
        @if (User.IsInRole("Admin"))
        {
            <aside class="admin-view-note" aria-label="Administratorinformation">
                <strong>Admin view</strong>
                <span>
                    You can view open study sessions. Only students can book rooms or join study sessions.
                </span>
            </aside>
        }
        
        <div class="eyebrow">BOOK ROOMS AND STUDY TOGETHER</div>
        <h1 id="home-title">Find a study room for your group work</h1>
        <p>
            Find an available room, meet other students and make the study session easier.
        </p>
        <a class="btn btn-primary btn-lg" 
            asp-controller="Home" 
            asp-action="Book">
            Book a room
        </a>
    </div>

    @if (Model.FeaturedAvailableRoom is { } featuredRoom)
    {
        <div class="hero-art room-feature">
            <img src="~/images/study3.jpg" alt="" />
            <div class="room-feature-card">
                <div class="eyebrow muted">ROOM STATUS: AVAILABLE</div>
                <h2>Room @featuredRoom.RoomNumber</h2>

                @if (!string.IsNullOrWhiteSpace(featuredRoom.Location))
                {
                    <p>Location: @featuredRoom.Location</p>
                }

                <p>Capacity: @featuredRoom.Capacity</p>
                <a class="outline-button" 
                    asp-controller="Home" 
                    asp-action="Book">
                    Check booking times
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="hero-art room-feature">
            <img src="~/images/study3.jpg" alt="" />
            <div class="room-feature-card">
                <h2>No rooms are available</h2>
                <p>You can still browse all rooms below.</p>
                <a class="outline-button" href="#rooms">
                    Browse rooms
                </a>
            </div>
        </div>
    }
</section>

<!-- Room directory section -->
<section id="rooms" class="sessions-section" aria-labelledby="rooms-title">
    <div class="section-heading">
        <div>
            <div class="eyebrow muted">ROOM DIRECTORY</div>
            <h2 id="rooms-title">Rooms on campus</h2>
            <p>
                @Model.Rooms.Count
                @(Model.Rooms.Count == 1 ? "room" : "rooms")
                available in the system.
            </p>
        </div>
    </div>

    @if (Model.Rooms.Count == 0)
    {
        <div class="empty-state" role="status">
            <h3>No rooms available</h3>
            <p>Please check back later.</p>
        </div>
    }
    else
    {
        <div class="session-grid">
            @foreach (var room in Model.Rooms)
            {
                <article class="session-card">
                    <div class="card-top">
                        @if (room.Status == Room.Availability.Available)
                        {
                            <span class="course-tag sage">Available</span>
                        }
                        else
                        {
                            <span class="course-tag peach">Not available</span>
                        }
                    </div>

                    <h3>Room @room.RoomNumber</h3>

                    @if (!string.IsNullOrWhiteSpace(room.Location))
                    {
                        <p class="session-info">
                            <span class="fw-semibold">Location:</span>
                            @room.Location
                        </p>
                    }

                    <p class="session-info">
                        <span class="fw-semibold">Capacity:</span>
                        @room.Capacity people
                    </p>

                    @if (room.Status == Room.Availability.Available)
                    {
                        <div class="card-bottom">
                            <a class="btn btn-primary" asp-controller="Home" asp-action="Book">Book room
                                <span class="visually-hidden">for room @room.RoomNumber</span>
                            </a>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>


<section id="sessions" 
        class="sessions-section" 
        aria-labelledby="sessions-title">

    <div class="section-heading">
        <div>
            <div class="eyebrow muted">FIND OTHER STUDENTS</div>
            <h2 id="sessions-title">Open study sessions</h2>
            <p>Small groups, shared goals and space for you.</p>
        </div>
    </div>
    
    <div class="results-meta">
        <span id="resultCount" aria-live="polite">Showing @Model.OpenStudySessions.Count study sessions</span>
        <span> Available spots</span>
    </div>

<!-- Study session cards -->
     @if (Model.OpenStudySessions.Count == 0)
    {
        <div class="empty-state" role="status">
            <h3>There are no open study sessions available</h3>
            <p>Please check back later or book a room to create a new study session <a asp-controller="Home" asp-action="Book">here</a>.</p>
        </div>
    }
    else
    {
        <div class="session-grid">
            @foreach (var session in Model.OpenStudySessions)
            {
                <article class="session-card" 
                        data-subject="@session.Subject" 
                        data-start="@session.Booking.StartTime.ToString("yyyy.MM.dd HH:mm")" 
                        data-search="@($"{session.Title} {session.Subject} {session.Booking.Description} {session.Booking.Room?.RoomNumber} {session.Booking.Room?.Location}")">
                    @* Card content *@
                    <div class="card-top">
                        <span class="course-tag sage">
                            @session.Subject ?? "Study session"
                        </span>
                    </div>

                    <h3>@session.Title</h3>

                    <p class="session-description">
                        @(session.Booking.Description ?? "No description provided.")
                    </p>

                    <div class="session-info">
                        <span>
                             @session.Booking.StartTime.ToString("yyyy.MM.dd HH:mm")
                             -
                             @session.Booking.EndTime.ToString("HH:mm")
                        </span>
                    </div>

                    <div class="session-info">
                        <span>
                            Room @session.Booking.Room?.RoomNumber ?? "-"
                        </span>
                    </div>

                    <div class="card-bottom">
                        <div class="attendees">
                            <span>
                                <b>@(session.MaxParticipants - session.Participants.Count)</b> of @session.MaxParticipants spots available
                            </span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
