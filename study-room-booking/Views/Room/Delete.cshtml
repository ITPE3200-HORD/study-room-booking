@model Room

@{
    ViewData["Title"] = "Delete room";
}

<section class="container py-4" aria-labelledby="delete-room-title">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <header class="mb-4">
                        <h1 id="delete-room-title" class="h2">Delete room</h1>
                        <p class="mb-0">
                            Are you sure you want to delete room @Model.RoomNumber?
                        </p>
                    </header>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@(Model.Location ?? "—")</dd>

                        <dt class="col-sm-4">Room type</dt>
                        <dd class="col-sm-8">@Model.RoomType</dd>

                        <dt class="col-sm-4">Capacity</dt>
                        <dd class="col-sm-8">@Model.Capacity people</dd>

                        <dt class="col-sm-4">Availability</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == Room.Availability.Available)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Not available</span>
                            }
                        </dd>
                    </dl>

                    <form asp-action="DeleteConfirmed" asp-route-id="@Model.RoomId" method="post">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-danger crud-btn">Delete room</button>
                            <a asp-action="Table" class="btn btn-outline-secondary crud-btn">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
