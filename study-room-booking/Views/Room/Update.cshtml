@model Room

<h2>Update Room</h2>

<form asp-action="Update">
    <input type="hidden" asp-for="RoomId">
    <div class="form-group">
        <label asp-for="RoomId"></label>
        <input asp-for="RoomId" class="form-control"/>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="RoomName"></label>
            <input asp-for="RoomName" class="form-control"/>
            <span asp-validation-for="RoomName"></span>
    </div>
     <div class="form-group">
        <label asp-for=Location"></label>
        <input asp-for="Location" class="form-control"/>
        <span asp-validation-for="Location"></span>
       
     <div class="form-group">
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" class="form-control"/>
        <span asp-validation-for="Capacity"></span>
     </div>
     <div class="form-group">
        <label asp-for="IsActve"></label>
        <input asp-for="IsActve" class="form-control"/>   
        <span asp-validation-for="IsActve"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Table" class="btn btn-secondary">Cancel</a>
</form>