@model Room

@{
    ViewData["Title"] = "Update room";
}

<section class="container py-4" aria-labelledby="update-room-title">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7 col-xl-6">
            <header class="mb-4">
                <h1 id="update-room-title" class="h2">Update room</h1>
                <p class="text-body-secondary mb-0">
                    Edit the room details and save your changes.
                </p>
            </header>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Update" method="post" class="d-grid gap-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <input type="hidden" asp-for="RoomId" />

                        <div>
                            <label asp-for="Location" class="form-label">Location</label>
                            <select asp-for="Location" class="form-control" required>
                                <option value="P35">P35</option>
                                <option value="P32">P32</option>
                                <option value="P46">P46</option>
                                <option value="P48">P48</option>
                            </select>
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="RoomNumber" class="form-label">Room number</label>
                            <input asp-for="RoomNumber" class="form-control" />
                            <span asp-validation-for="RoomNumber" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="RoomType" class="form-label">Room type</label>
                            <select asp-for="RoomType" class="form-select">
                                <option value="">Select a room type</option>
                                <option value="Group Study Room">Group Study Room</option>
                                <option value="Class Room">Class Room</option>
                                <option value="Auditorium">Auditorium</option>
                            </select>
                            <span asp-validation-for="RoomType" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Capacity" class="form-label">Capacity</label>
                            <input asp-for="Capacity" class="form-control" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 pt-2">
                            <button type="submit" class="btn btn-primary crud-btn">Save changes</button>
                            <a asp-action="Table" class="btn btn-outline-secondary crud-btn">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
