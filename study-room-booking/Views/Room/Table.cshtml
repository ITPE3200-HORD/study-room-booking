@model RoomsViewModel

@{
    ViewData["Title"] = "Rooms";
}

<section class="container py-4" aria-labelledby="rooms-title">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 id="rooms-title" class="h2 mb-0">Rooms</h1>
            <p class="text-body-secondary mb-0">View and manage rooms.</p>
        </div>
        

        <a asp-action="Create" class="btn btn-primary crud-btn">
            Add a room
        </a>
    </header>

    @if (Model.Rooms.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption class="visually-hidden">
                    Rooms with their location, type, capacity, availability and management actions.
                </caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col">Room number</th>
                        <th scope="col">Location</th>
                        <th scope="col">Room type</th>
                        <th scope="col">Capacity</th>
                        <th scope="col">Availability</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <th scope="row">@room.RoomNumber</th>
                            <td>@(room.Location ?? "—")</td>
                            <td>@room.RoomType</td>
                            <td>@room.Capacity people</td>
                            <td>
                                @if (room.Status == Room.Availability.Available)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not available</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Update"
                                       asp-route-id="@room.RoomId"
                                       class="btn btn-primary btn-sm crud-btn">
                                        Edit
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@room.RoomId"
                                       class="btn btn-outline-danger btn-sm crud-btn">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state" role="status">
            <h2 class="h4">No rooms have been added yet</h2>
            <p>Start by adding the first room.</p>
            <a asp-action="Create" class="outline-button">Add a room</a>
        </div>
    }
</section>
