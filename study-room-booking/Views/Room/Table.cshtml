@model RoomsViewModel

<h1>List of Rooms (@Model.CurrentViewName View)</h1> @* Fixed: removed extra > *@
<a asp-action="Create" class="btn btn-primary mb-3">Create new room</a> @*Added a 'create-new-room'-button *@

<div class="container"> 
    <table class="table table-striped">
        <tr><th>RoomId</th><th>Room Name</th><th>Location</th><th>Capacity</th><th>Is active</th></tr>            
        @foreach (var Room in Model.Rooms)
                {
                    <tr>
                        <td>@Room.RoomId</td>
                        <td>@Room.RoomName</td>
                        <td>@Room.Location</td>
                        <td>@Room.Capacity</td>
                        <td>@Room.IsActve</td> @* Added: shows IsActve value *@ 
                    </tr>
                }
            </table>
    </div>