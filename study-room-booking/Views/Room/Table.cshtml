@model RoomsViewModel

<h1>List of Rooms (@Model.CurrentViewName View)</h1> @* Fixed: removed extra > *@
<a asp-action="Create" class="btn btn-primary mb-3">Create new room</a> @*Added a 'create-new-room'-button *@

<div class="container"> 
    <table class="table table-striped">
        <tr>
            <th>Room Id</th>
            <th>Location</th>
            <th>Room Number</th>
            <th>Room Type</th>
            <th>Capacity</th>
            <th>Availability</th>
            <th>Actions</th>
        </tr>            
        @foreach (var Room in Model.Rooms)
                {
                    <tr>
                        <td>@Room.RoomId</td>
                        <td>@Room.Location</td>
                        <td>@Room.RoomNumber</td>
                        <td>@Room.RoomType</td>
                        <td>@Room.Capacity</td>
                        <td>@Room.Status</td>
                        <td>
                            <a asp-action="Update" asp-route-id="@Room.RoomId">Update</a>
                            <a asp-action="Delete" asp-route-id="@Room.RoomId">Delete</a>
                        </td>
                    </tr>
                }
            </table>
    </div>