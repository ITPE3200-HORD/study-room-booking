@model study_room_booking.Models.Student

@{
    ViewData["Title"] = "Delete student";
}

<section class="container py-4" aria-labelledby="delete-student-title">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <header class="mb-4">
                        <h1 id="delete-student-title" class="h2">Delete student</h1>
                        <p class="mb-0">
                            Are you sure you want to delete @Model.FullName and their login account? 
                            This action cannot be undone.
                        </p>
                    </header>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Student ID</dt>
                        <dd class="col-sm-8">@(Model.StudentId)</dd>

                        <dt class="col-sm-4">Full name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@(Model.IdentityUser?.Email ?? "—")</dd>

                        <dt class="col-sm-4">Username</dt>
                        <dd class="col-sm-8">@(Model.IdentityUser?.UserName ?? "—")</dd>
                    </dl>

                    <form asp-action="DeleteConfirmed" 
                        asp-route-id="@Model.StudentId" 
                        method="post">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-danger">Delete student</button>
                            <a asp-action="Table" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>