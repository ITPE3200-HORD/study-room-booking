@model study_room_booking.Models.Student;

<h2>Delete Student</h2>

<h3>Are you sure you want to delete this student and their login account?</h3>
<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Student Id</dt>
        <dd class="col-sm-10">@Model.StudentId</dd>

        <dt class="col-sm-2">Full Name</dt>
        <dd class="col-sm-10">@Model.FullName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.IdentityUser?.Email</dd>

        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.IdentityUser?.UserName</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.StudentId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Table" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}