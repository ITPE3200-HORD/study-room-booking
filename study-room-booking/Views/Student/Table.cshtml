@model study_room_booking.ViewModels.StudentViewModel

<h1>Students (@Model.CurrentViewName)</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Full Name</th>
            <th>Username</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model.Students)
        {
            <tr>
                <td>@student.StudentId</td>
                <td>@student.FullName</td>
                <td>@student.IdentityUser?.UserName</td>
                <td>@student.IdentityUser?.Email</td>
                <td>
                    <a asp-action="Update" asp-route-id="@student.StudentId" class="btn btn-primary">Update</a>
                    <a asp-action="Delete" asp-route-id="@student.StudentId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
