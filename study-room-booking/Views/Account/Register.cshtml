@model RegisterViewModel

<section class="auth-page" aria-labelledby="register-title">
    <div class="auth-card">
        <a class="auth-back" asp-controller="Home" asp-action="Index">← To front page</a>
        
        <!--<div class="auth-mark" aria-hidden=""> evt. logo her </div> -->
        <h1 id="register-title">Register</h1>
        <p class="auth-description">Create a new account</p>
        
        <form asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>
            
            <label asp-for="Username" class="control-label" autocomplete="username" placeholder="Username"></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>

            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>

            <label asp-for="Password" class="control-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Password" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <label asp-for="ConfirmPassword" class="control-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="current-password" placeholder="Confirm Password" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

            <button class="btn btn-primary" type="submit">Register</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
