@model Booking

@{
    ViewData["Title"] = "Update booking";
}

<section class="container py-4" aria-labelledby="update-booking-title">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7 col-xl-6">
            <header class="mb-4">
                <h1 id="update-booking-title" class="h2">Update booking</h1>
                <p class="text-body-secondary mb-0">
                    Edit the booking details and save your changes.
                </p>
            </header>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Update" method="post" class="d-grid gap-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>


                        <div>
                            <label class="form-label">Room</label>
                            <input type="text" class="form-control"
                                   style="background-color: #e9ecef; cursor: not-allowed;" value="@Model.Room?.RoomNumber"
                                   readonly />
                            <input type="hidden" asp-for="RoomId" />
                            <span asp-validation-for="RoomId" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="UserName" class="form-label">Name</label>
                            <input asp-for="UserName" class="form-control"
                                   style="background-color: #e9ecef; cursor: not-allowed;" readonly />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div>
                            <label class="form-label" for="bookingDate">Date</label>
                            <input type="date" id="bookingDate" class="form-control"
                                   style="background-color: #e9ecef; cursor: not-allowed;"
                                   value="@Model.StartTime.ToString("yyyy-MM-dd")" readonly />
                        </div>

                        <div>
                            <label class="form-label" for="StartTime">Start time</label>
                            <select id="StartTime" asp-for="StartTime" class="form-select"
                                    value="@Model.StartTime.ToString(format: "yyyy-MM-dd HH:mm");">
                                <option value="06:00">06:00</option>
                                <option value="07:00">07:00</option>
                                <option value="08:00">08:00</option>
                                <option value="09:00">09:00</option>
                                <option value="10:00">10:00</option>
                                <option value="11:00">11:00</option>
                                <option value="12:00">12:00</option>
                                <option value="13:00">13:00</option>
                                <option value="14:00">14:00</option>
                                <option value="15:00">15:00</option>
                                <option value="16:00">16:00</option>
                                <option value="17:00">17:00</option>
                                <option value="18:00">18:00</option>
                                <option value="19:00">19:00</option>
                                <option value="20:00">20:00</option>
                                <option value="21:00">21:00</option>
                                <option value="22:00">22:00</option>
                            </select>
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                        
                        <div>
                            <label class="form-label" for="EndTime">End time</label>
                            <select id="EndTime" asp-for="EndTime" class="form-select"
                                    value="@Model.EndTime.ToString(format: "HH:mm");">
                                <option value="06:00">06:00</option>
                                <option value="07:00">07:00</option>
                                <option value="08:00">08:00</option>
                                <option value="09:00">09:00</option>
                                <option value="10:00">10:00</option>
                                <option value="11:00">11:00</option>
                                <option value="12:00">12:00</option>
                                <option value="13:00">13:00</option>
                                <option value="14:00">14:00</option>
                                <option value="15:00">15:00</option>
                                <option value="16:00">16:00</option>
                                <option value="17:00">17:00</option>
                                <option value="18:00">18:00</option>
                                <option value="19:00">19:00</option>
                                <option value="20:00">20:00</option>
                                <option value="21:00">21:00</option>
                                <option value="22:00">22:00</option>
                            </select>
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </form>

                        <form asp-action="MyPage/MyPage" method="post">
                            <input type="hidden" name="id" value="@Model.BookingId" />

                            <div class="d-flex flex-wrap gap-2 pt-2">
                                <button type="submit" class="btn btn-primary crud-btn">Save changes</button>
                            </div>
                        </form>

                        <form asp-action="Cancel" method="post">
                            <input type="hidden" name="id" value="@Model.BookingId" />
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="MyPage" asp-action="MyPage" class="btn btn-outline-secondary crud-btn">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
