@model Booking

@* Confirmation page before deleting a booking *@

<h2>Delete Booking</h2>

<p>Are you sure you want to delete this booking?</p>

<table class="table">
    <tr><th>Room</th><td>@Model.Room?.RoomNumber</td></tr>
    <tr><th>Name</th><td>@Model.UserName</td></tr>
    <tr><th>Description</th><td>@Model.Description</td></tr>
    <tr><th>Start</th><td>@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</td></tr>
    <tr><th>End</th><td>@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</td></tr>
</table>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.BookingId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Table" class="btn btn-secondary">Cancel</a>
</form>