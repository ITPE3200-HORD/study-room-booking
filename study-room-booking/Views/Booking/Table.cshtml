@model IEnumerable<Booking>

@{
    ViewData["Title"] = "Bookings";
}

<section class="container py-4" aria-labelledby="bookings-title">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 id="bookings-title" class="h2 mb-0">Bookings</h1>
            <p class="text-body-secondary mb-0">View and manage room bookings.</p>
        </div>
    </header>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <caption class="visually-hidden">
                    Room bookings with the room, booker, description, times and management actions.
                </caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col">Room</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                        <th scope="col">Start</th>
                        <th scope="col">End</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <th scope="row">@(booking.Room?.RoomNumber ?? "—")</th>
                            <td>@(booking.UserName ?? "—")</td>
                            <td>@(booking.Description ?? "—")</td>
                            <td>@booking.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@booking.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Update"
                                       asp-route-id="@booking.BookingId"
                                       class="btn btn-primary btn-sm crud-btn">
                                        Edit
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@booking.BookingId"
                                       class="btn btn-outline-danger btn-sm crud-btn">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state" role="status">
            <h2 class="h4">No bookings found</h2>
            <p>Room bookings will appear here.</p>
        </div>
    }
</section>
