@*Laget av claude - her må det mer til!*@

@using study_room_booking.ViewModels
@model BookingCreateViewModel

<h1>Confirm your booking</h1>

<dl>
    <dt>Room</dt><dd>@Model.RoomNumber</dd>
    <dt>Date</dt><dd>@Model.Date.ToString("yyyy-MM-dd")</dd>
    <dt>Start</dt><dd>@Model.StartTime.ToString(@"hh\:mm")</dd>
    <dt>Duration</dt><dd>@Model.DurationMinutes minutes</dd>
</dl>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <input type="hidden" asp-for="RoomId" />
    <input type="hidden" asp-for="RoomNumber" />
    <input type="hidden" asp-for="Date" />
    <input type="hidden" asp-for="StartTime" />
    <input type="hidden" asp-for="DurationMinutes" />


    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    @* Checkbox for creating a study session *@
    <div class="form-check mb-3">
        <input asp-for="CreateStudySession" class="form-check-input" />
        <label asp-for="CreateStudySession" class="form-check-label">Open this booking as a study session</label>
    </div>

    <div id="study-session-fields" class="border rounded p-3 mb-3" hidden>
        <div class="mb-3">
            <label asp-for="SessionTitle" class="form-label">Session title</label>
            <input asp-for="SessionTitle" class="form-control" />
            <span asp-validation-for="SessionTitle" class="text-danger"></span>
        </div>
        

        <div class="mb-3">
            <label asp-for="SessionSubject" class="form-label">Subject</label>
            <input asp-for="SessionSubject" class="form-control" />
            <span asp-validation-for="SessionSubject" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="SessionMaxParticipants" class="form-label">Maximum participants</label>
            <input asp-for="SessionMaxParticipants" type="number" min="1" max="50" class="form-control" />
            <span asp-validation-for="SessionMaxParticipants" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Confirm booking</button>
    <a asp-controller="Home" asp-action="Book" class="btn btn-secondary">Back</a>
</form>

<script>
    (() => {
        const checkbox = document.getElementById('@Html.IdFor(model => model.CreateStudySession)');
        const fields = document.getElementById('study-session-fields');

        const updateVisibility = () => {
            fields.hidden = !checkbox.checked;
        };

        checkbox.addEventListener('change', updateVisibility);
        updateVisibility();
    })();
</script>
@* LoadsjQuery Validation so the DataAnnotations rules (e.g. max lenght)
    are also checked in the browser before the form is sent.
    The server still validates everything when the booking is saved. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
