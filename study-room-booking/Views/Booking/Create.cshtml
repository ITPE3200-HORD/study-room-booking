@model Booking

@* Form for creating a new booking *@

<h2>Ny booking</h2>

<form asp-action="Create" method="post">
    @* Shows errors that are not tied to one field, e.g. overlapping booking *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="RoomId" class="form-label">Rom</label>
        <select asp-for="RoomId" asp-items="ViewBag.Rooms" class="form-select">
            <option value="0">-- Velg rom --</option>
        </select>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UserName" class="form-label">Navn</label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Beskrivelse</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartTime" class="form-label">Starttid</label>
        <input asp-for="StartTime" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndTime" class="form-label">Sluttid</label>
        <input asp-for="EndTime" class="form-control" />
        <span asp-validation-for="EndTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lagre</button>
    <a asp-action="Table" class="btn btn-secondary">Avbryt</a>
</form>
