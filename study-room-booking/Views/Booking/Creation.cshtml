@*Laget av claude - her må det mer til!*@

@using study_room_booking.ViewModels
@model BookingCreationViewModel

<h1>Confirm your booking</h1>

<dl>
    <dt>Room</dt><dd>@Model.RoomNumber</dd>
    <dt>Date</dt><dd>@Model.Date.ToString("yyyy-MM-dd")</dd>
    <dt>Start</dt><dd>@Model.StartTime.ToString(@"hh\:mm")</dd>
    <dt>Duration</dt><dd>@Model.DurationMinutes minutes</dd>
</dl>

<form asp-action="Creation" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <input type="hidden" asp-for="RoomId" />
    <input type="hidden" asp-for="RoomNumber" />
    <input type="hidden" asp-for="Date" />
    <input type="hidden" asp-for="StartTime" />
    <input type="hidden" asp-for="DurationMinutes" />


    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Confirm booking</button>
    <a asp-controller="Home" asp-action="Book" class="btn btn-secondary">Back</a>
</form>