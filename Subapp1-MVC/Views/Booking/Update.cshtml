@model Booking

@{
    ViewData["Title"] = "Update booking";
}

<section class="container py-4" aria-labelledby="update-booking-title">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7 col-xl-6">
            <header class="mb-4">
                <h1 id="update-booking-title" class="h2">Update booking</h1>
                <p class="text-body-secondary mb-0">
                    Edit the booking details and save your changes.
                </p>
            </header>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Update" method="post" class="d-grid gap-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <input type="hidden" asp-for="BookingId" />
                        <input type="hidden" asp-for="RoomId" />

                        <div>
                            <label class="form-label">Room</label>
                            <input type="text" class="form-control"
                                   style="background-color: #e9ecef; cursor: not-allowed;"
                                   value="@Model.Room?.RoomNumber" readonly />
                        </div>

                        <div>
                            <<label class="form-label">Name</label>
                            <input class="form-control" value="@Model.Student?.FullName" />
                                   style="background-color: #e9ecef; cursor: not-allowed;" readonly />
                        </div>

                        <div>
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div>
                            <label class="form-label" for="bookingDate">Date</label>
                            <input type="date" id="bookingDate" class="form-control"
                                   style="background-color: #e9ecef; cursor: not-allowed;"
                                   value="@Model.StartTime.ToString("yyyy-MM-dd")" readonly />
                        </div>

                        <div>
                            <label class="form-label" for="StartTime">Start time</label>
                            <select id="StartTime" name="StartTime" class="form-select">
                                @for (int h = 6; h <= 22; h++)
                                {
                                    var t = $"{h:00}:00";
                                    <option value="@t" selected="@(t == Model.StartTime.ToString("HH:mm"))">@t</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="form-label" for="EndTime">End time</label>
                            <select id="EndTime" name="EndTime" class="form-select">
                                @for (int h = 6; h <= 22; h++)
                                {
                                    var t = $"{h:00}:00";
                                    <option value="@t" selected="@(t == Model.EndTime.ToString("HH:mm"))">@t</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex flex-wrap gap-2 pt-2">
                            <button type="submit" class="btn btn-primary crud-btn">Save changes</button>
                            <a asp-controller="MyPage" asp-action="MyPage"
                               class="btn btn-outline-secondary crud-btn">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}