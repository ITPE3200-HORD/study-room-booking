@model study_room_booking.ViewModels.StudySessionUpdateViewModel

@{ 
    ViewData["Title"] = "Edit study session"; 
}

<h1>Edit study session</h1>

<form asp-action="Update"
      asp-route-id="@Model.StudySessionId"
      method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaxParticipants" class="form-label">Maximum participants (including you)</label>
        <input asp-for="MaxParticipants" type="number" min="2" max="50"  class="form-control"/>
        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsOpen" class="form-check-input" />
        <label asp-for="IsOpen" class="form-check-label">Open for students to join</label>
    </div>

    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-controller="MyPage" asp-action="MyPage" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}